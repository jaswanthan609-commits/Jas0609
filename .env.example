# Copy to .env and fill in. Only ANTHROPIC_API_KEY is needed to start; the rest unlock each step.
ANTHROPIC_API_KEY=sk-ant-...
PEXELS_API_KEY=...          # https://www.pexels.com/api/
PIXABAY_API_KEY=...         # https://pixabay.com/api/docs/
SARVAM_API_KEY=...          # https://dashboard.sarvam.ai (Hindi/Tamil voice)
ELEVENLABS_API_KEY=...      # https://elevenlabs.io (English voice)
GEMINI_API_KEY=...          # https://aistudio.google.com/apikey (kids illustrations)
# YOUTUBE_CLIENT_SECRETS=client_secret.json
